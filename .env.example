# ── Datenbank ──────────────────────────────────────────────────────────────
POSTGRES_DB=projektmanagement
POSTGRES_USER=pm
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+psycopg://pm:change-me-strong-password@db:5432/projektmanagement

# ── Verschlüsselung (32 Bytes, Base64) ───────────────────────────────────────
# Erzeugen: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_MASTER_KEY=

# ── Auth / Sessions ─────────────────────────────────────────────────────────
# Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=

# Session-Laufzeit in Sekunden (Standard: 8 h)
SESSION_TTL_SEC=28800

# Argon2id / PBKDF2
PBKDF2_ITERATIONS=600000

# ── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Frontend-Origin(s) für CORS (kommagetrennt). Lokal: localhost + LAN-IP
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LAN-Zugriff (CT 129 per IP): zusätzlich eintragen, z. B.:
# CORS_ORIGINS=http://localhost:3000,http://192.168.131.40:3000

# ── Frontend (Next.js API-Proxy) ────────────────────────────────────────────
# Laufzeit-URL des Backends im Docker-Netz (Route Handler /api/*)
API_INTERNAL_URL=http://api:8000

# Produktion hinter nginx + TLS (siehe doku/pve2/vm/129-projektmanagement/):
# CORS_ORIGINS=https://pm.santinel.li
# COOKIE_SECURE=true

# ── Multi-Tenant (später SaaS) ──────────────────────────────────────────────
# Leer = Single-Tenant Self-Host
DEFAULT_TENANT_SLUG=default

# Registrierung über API erlauben (Self-Host: meist false, Admin per Script)
ALLOW_REGISTRATION=false

# Cookies: COOKIE_SECURE=true hinter HTTPS in Produktion
COOKIE_SECURE=false

# ── KI (Credentials nur hier — niemals in der Benutzer-UI) ───────────────────
#
# Betreiber pflegt API-Keys und Ollama-URL ausschließlich in dieser Datei
# (/opt/projektmanagement/.env auf CT 129). Benutzer wählen nur Anbieter + Modell
# unter «KI-Einstellungen» in der App.
#
# Ollama (lokal/LAN): IP des Ollama-Hosts, Port 11434
#   CT 129 → Ollama auf anderem Host: http://192.168.x.x:11434
#   Ollama auf demselben CT: http://127.0.0.1:11434 (nur wenn Ollama im CT läuft)
OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Standard-Fallback, wenn ein Benutzer noch keine persönliche Wahl gespeichert hat:
LLM_PROVIDER=ollama
# Pro Provider (empfohlen) — oder Legacy LLM_MODEL für den Default-Provider
LLM_MODEL_OLLAMA=llama3.3:70b
LLM_MODEL_OPENAI=gpt-4.1-mini
LLM_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
# Legacy (nur wenn LLM_MODEL_OLLAMA/… leer): gilt für LLM_PROVIDER
LLM_MODEL=
#
# OpenAI (ChatGPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
#
# Anthropic (Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
#
# PII-Gate vor Cloud-Versand (INTERNAL/CONFIDENTIAL werden anonymisiert)
PII_ANONYMIZER_ENABLED=true
PII_ANONYMIZER_REQUIRED=true

# Legacy (meist leer lassen)
LLM_BASE_URL=
LLM_API_KEY_FALLBACK=
